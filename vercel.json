{
  "buildCommand": "npm run build",
  "installCommand": "echo skip-install",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/guide", "destination": "https://www.ereeneesmglcargo.mn/brandbook/guide", "permanent": true },
    { "source": "/guide/:path*", "destination": "https://www.ereeneesmglcargo.mn/brandbook/guide", "permanent": true },
    { "source": "/studio", "destination": "https://www.ereeneesmglcargo.mn/brandbook/studio", "permanent": true },
    { "source": "/studio/:path*", "destination": "https://www.ereeneesmglcargo.mn/brandbook/studio", "permanent": true },
    { "source": "/", "destination": "https://www.ereeneesmglcargo.mn/brandbook", "permanent": true },
    { "source": "/:path*", "destination": "https://www.ereeneesmglcargo.mn/brandbook", "permanent": true }
  ]
}
