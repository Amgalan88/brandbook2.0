{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/guide", "destination": "/index.html" },
    { "source": "/guide/:path*", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/index.html" }
  ]
}
